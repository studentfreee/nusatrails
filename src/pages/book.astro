---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm';
import Photo from '../components/Photo.astro';
import { getTrips } from '../lib/data';
import { WHATSAPP_NUMBER } from '../lib/site';

const trips = getTrips();
---

<Base
  description="Book your private tour in Java: Ijen, Bromo, Tumpak Sewu, Sukamade, Borobudur and Prambanan. Get a reference number instantly, no upfront payment required."
  ogTitle="Book a Private Trip – NusaTrails"
>
  <!-- Hero Section matching design reference (03-book.html) -->
  <section class="relative overflow-hidden min-h-[380px] md:min-h-[440px] flex items-end pb-12 pt-32 bg-[#0b0a0a]">
    <div class="absolute inset-0 z-0">
      <Photo
        assetKey="tim24"
        alt="NusaTrails Ijen group on crater rim"
        loading="eager"
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradient overlay matching design reference (03-book.html) -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(90deg, rgba(11,10,10,.62) 0%, rgba(11,10,10,.28) 55%, rgba(11,10,10,.12) 100%), linear-gradient(180deg, rgba(11,10,10,.28) 0%, rgba(11,10,10,0) 35%, rgba(11,10,10,.55) 80%, #0b0a0a 100%);"
      ></div>
    </div>

    <div class="container-nt relative z-10 w-full">
      <h1 class="font-display font-semibold text-[72px] sm:text-[110px] md:text-[160px] lg:text-[180px] leading-none tracking-[0.03em] text-[#fff6e8]/90 uppercase m-0">
        Book
      </h1>
      <p class="max-w-[560px] mt-3 text-base md:text-lg text-[#d9d3c8] leading-relaxed">
        Tell us your dates and group size. We reply with availability and a final quote.
      </p>
    </div>
  </section>

  <!-- Interactive Booking Flow Island -->
  <section class="py-12 md:py-16 bg-[#0b0a0a]">
    <div class="container-nt">
      <BookingForm
        client:load
        trips={trips}
        whatsappNumber={WHATSAPP_NUMBER}
      />
    </div>
  </section>
</Base>
