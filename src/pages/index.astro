            <div class="relative">
              <span class="absolute inset-0 rounded-full bg-[var(--nt-lime)] opacity-25 group-hover:animate-ping"></span>
              <span class="step-badge relative w-11 h-11 rounded-full bg-[var(--nt-lime)] text-[#14170a] font-bold text-base flex items-center justify-center shadow-lg group-hover:scale-115 group-hover:rotate-12 transition-transform duration-300">
                3
              </span>
