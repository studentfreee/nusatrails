---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import TripCard from '../components/TripCard.astro';
import { getTrips } from '../lib/data';

const allTrips = getTrips();

// Popular trips slugs defined in PRD section 6.1
const popularSlugs = [
  'ijen-blue-fire-1-day',
  'ijen-bromo-3d2n-from-surabaya',
  'ijen-tumpak-sewu-bromo-4d3n-bali-to-surabaya',
  'sukamade-wildlife-2d1n-from-banyuwangi',
  'borobudur-prambanan-1-day-from-yogyakarta',
  'jomblang-pindul-cave-1-day-from-yogyakarta',
];

const popularTrips = popularSlugs
  .map((slug) => allTrips.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'NusaTrails',
  url: 'https://nusatrails.id',
  logo: 'https://nusatrails.id/icon-512.png',
  description:
    'Private tours across East Java and Yogyakarta: Ijen blue fire, Mount Bromo, Tumpak Sewu, Sukamade, and Borobudur.',
  areaServed: ['East Java', 'Yogyakarta', 'Bali', 'Indonesia'],
  priceRange: '$$',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer Reservations',
    availableLanguage: ['English', 'Indonesian'],
  },
};
---

<Base
  description="Private trips across East Java & Yogyakarta: Ijen blue fire, Mount Bromo, Tumpak Sewu waterfall, Sukamade turtles, Borobudur and Prambanan. Small private groups with driver and guide."
  ogTitle="NusaTrails – Private Trips in East Java & Yogyakarta"
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- 1. HERO SECTION (Layered title - Key effect) -->
  <section class="relative overflow-hidden h-[740px] sm:h-[800px] lg:h-[820px] bg-[#0b0a0a]">
    <!-- Layer 1: Background mountain photo -->
    <div class="absolute inset-0 z-0">
      <Photo
        assetKey="bromo_mist"
        alt="Mount Bromo Caldera"
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
    </div>

    <!-- Layer 2: Big Title behind the mountain ridge -->
    <div class="absolute top-[65px] lg:top-[70px] inset-x-0 mx-auto max-w-[1240px] px-6 lg:px-12 z-10 pointer-events-none select-none">
      <h1 class="font-heading font-semibold text-[76px] sm:text-[110px] md:text-[145px] lg:text-[180px] uppercase tracking-[0.03em] leading-none text-white/80 whitespace-nowrap">
        NusaTrails
      </h1>
    </div>

    <!-- Layer 3: Foreground photo clipped along mountain ridge -->
    <div class="absolute inset-0 z-20 pointer-events-none hero-clipped-ridge">
      <Photo
        assetKey="bromo_mist"
        alt=""
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
    </div>

    <!-- Layer 4: Dark gradient overlay (top .3 to clear, clear to .6 at 72%, then #0b0a0a at bottom) -->
    <div class="absolute inset-0 z-20 pointer-events-none bg-gradient-to-b from-[#0b0a0a]/30 via-transparent to-[#0b0a0a] via-[45%]"></div>

    <!-- Layer 5: Hero Content (Bottom cards and CTAs) -->
    <div class="absolute bottom-10 lg:bottom-14 inset-x-0 mx-auto max-w-[1240px] px-6 lg:px-12 z-30">
      <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 lg:gap-8">
        <!-- 5 Mini Photo Cards -->
        <div class="w-full lg:w-auto overflow-x-auto pb-2 scrollbar-none">
          <div class="flex gap-3.5 min-w-max">
            <!-- Card 1 -->
            <div class="glass w-32 md:w-36 p-2 rounded-[10px] bg-black/55 flex flex-col">
              <div class="w-full h-28 md:h-36 rounded-[6px] overflow-hidden mb-2">
                <Photo assetKey="tim05" alt="Java destinations" class="w-full h-full object-cover" />
              </div>
              <p class="text-[12px] md:text-[13px] font-medium leading-tight text-white p-1">
                6 destinations<br /><span class="text-[var(--nt-muted)] font-normal">across Java</span>
              </p>
            </div>

            <!-- Card 2 -->
            <div class="glass w-32 md:w-36 p-2 rounded-[10px] bg-black/55 flex flex-col">
              <div class="w-full h-28 md:h-36 rounded-[6px] overflow-hidden mb-2">
                <Photo assetKey="IMG_2509" alt="Bromo sunrise" class="w-full h-full object-cover" />
              </div>
              <p class="text-[12px] md:text-[13px] font-medium leading-tight text-white p-1">
                sunrise at<br /><span class="text-[var(--nt-muted)] font-normal">2,700 m</span>
              </p>
            </div>

            <!-- Card 3 -->
            <div class="glass w-32 md:w-36 p-2 rounded-[10px] bg-black/55 flex flex-col">
              <div class="w-full h-28 md:h-36 rounded-[6px] overflow-hidden mb-2">
                <Photo assetKey="IMG_0683" alt="Ijen blue fire" class="w-full h-full object-cover" />
              </div>
              <p class="text-[12px] md:text-[13px] font-medium leading-tight text-white p-1">
                blue fire<br /><span class="text-[var(--nt-muted)] font-normal">at midnight</span>
              </p>
            </div>

            <!-- Card 4 -->
            <div class="glass w-32 md:w-36 p-2 rounded-[10px] bg-black/55 flex flex-col">
              <div class="w-full h-28 md:h-36 rounded-[6px] overflow-hidden mb-2">
                <Photo assetKey="tim10" alt="Pick-up points" class="w-full h-full object-cover" />
              </div>
              <p class="text-[12px] md:text-[13px] font-medium leading-tight text-white p-1">
                pick-ups from<br /><span class="text-[var(--nt-muted)] font-normal">Bali, Surabaya...</span>
              </p>
            </div>

            <!-- Card 5 -->
            <div class="glass w-32 md:w-36 p-2 rounded-[10px] bg-black/55 flex flex-col">
              <div class="w-full h-28 md:h-36 rounded-[6px] overflow-hidden mb-2">
                <Photo assetKey="fk_turtle" alt="Sukamade sea turtles" class="w-full h-full object-cover" />
              </div>
              <p class="text-[12px] md:text-[13px] font-medium leading-tight text-white p-1">
                sea turtles<br /><span class="text-[var(--nt-muted)] font-normal">at night</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Tag, Description & Action Buttons -->
        <div class="max-w-[420px] shrink-0 text-left lg:text-right">
          <div class="text-[12px] font-medium tracking-[0.08em] uppercase text-[var(--nt-lime)] mb-2">
            PRIVATE TRIPS · INDONESIA
          </div>
          <p class="text-sm md:text-base leading-relaxed text-[var(--nt-body)] mb-6">
            Private trips for small groups, picked up from Bali, Surabaya or Yogyakarta. From IDR 606.000 per person.
          </p>
          <div class="flex items-center gap-3 justify-start lg:justify-end">
            <a
              href="/trips"
              class="inline-flex items-center justify-center h-11 px-6 rounded-full border border-white/60 text-white text-sm font-medium hover:border-[var(--nt-lime)] hover:text-[var(--nt-lime)] transition"
            >
              See trips
            </a>
            <a
              href="/book"
              class="inline-flex items-center justify-center h-11 px-7 rounded-full bg-[var(--nt-lime)] text-[#14170a] text-sm font-semibold hover:brightness-110 transition"
            >
              Book
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ABOUT THE TOUR SECTION -->
  <section class="container-nt py-20 md:py-28" id="about">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Intro Description -->
      <div class="lg:col-span-5 sticky top-28">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-heading text-3xl md:text-4xl uppercase tracking-[0.04em] text-[var(--nt-body)]">
            About the tour
          </h2>
          <div class="flex-1 h-[1px] bg-white/20"></div>
        </div>
        <p class="text-base md:text-lg leading-relaxed text-[var(--nt-body)] mb-6">
          We've planned simple, convenient itineraries across Java. Choose from six places: <strong class="text-white">Ijen, Bromo, Tumpak Sewu and Sukamade</strong> in East Java, plus <strong class="text-white">Borobudur & Prambanan</strong> and <strong class="text-white">Jomblang & Pindul Cave</strong> near Yogyakarta.
        </p>
        <p class="text-sm md:text-base leading-relaxed text-[var(--nt-muted)]">
          No need to worry about routes, schedules or finding places. Everything is organized: private driver, English-speaking guide, tickets and stays. Pick 1 to 4 days and enjoy the journey.
        </p>
      </div>

      <!-- Right Column: Zig-zag Timeline -->
      <div class="lg:col-span-7 space-y-12 relative before:absolute before:left-1/2 before:top-4 before:bottom-4 before:-ml-[1px] before:w-[1px] before:bg-white/20 hidden md:block">
        <!-- Stop 1: Ijen -->
        <div class="grid grid-cols-2 gap-8 items-center relative">
          <div class="text-right pr-6">
            <span class="text-[13px] text-[var(--nt-muted)]">Midnight hike</span>
            <h3 class="font-heading text-2xl md:text-3xl font-medium text-white">Ijen</h3>
          </div>
          <div class="absolute left-1/2 -ml-[6px] w-3 h-3 rounded-full bg-[var(--nt-ink)] ring-4 ring-[#0b0a0a]"></div>
          <div class="flex gap-3 pl-6">
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_0683" alt="Ijen blue fire" class="w-full h-full object-cover" />
            </div>
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_3523" alt="Ijen crater" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <!-- Stop 2: Bromo -->
        <div class="grid grid-cols-2 gap-8 items-center relative">
          <div class="flex gap-3 justify-end pr-6">
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_3054" alt="Bromo jeep" class="w-full h-full object-cover" />
            </div>
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2507" alt="Bromo sunrise" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="absolute left-1/2 -ml-[6px] w-3 h-3 rounded-full bg-[var(--nt-ink)] ring-4 ring-[#0b0a0a]"></div>
          <div class="pl-6">
            <span class="text-[13px] text-[var(--nt-muted)]">4WD jeep at 03:30</span>
            <h3 class="font-heading text-2xl md:text-3xl font-medium text-white">Bromo</h3>
          </div>
        </div>

        <!-- Stop 3: Tumpak Sewu -->
        <div class="grid grid-cols-2 gap-8 items-center relative">
          <div class="text-right pr-6">
            <span class="text-[13px] text-[var(--nt-muted)]">Waterfall trek</span>
            <h3 class="font-heading text-2xl md:text-3xl font-medium text-white">Tumpak Sewu</h3>
          </div>
          <div class="absolute left-1/2 -ml-[6px] w-3 h-3 rounded-full bg-[var(--nt-ink)] ring-4 ring-[#0b0a0a]"></div>
          <div class="flex gap-3 pl-6">
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2414" alt="Tumpak Sewu vista" class="w-full h-full object-cover" />
            </div>
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2866" alt="Tumpak Sewu stairs" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <!-- Stop 4: Sukamade -->
        <div class="grid grid-cols-2 gap-8 items-center relative">
          <div class="flex gap-3 justify-end pr-6">
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="n_sukamade_jeep" alt="Sukamade offroad" class="w-full h-full object-cover" />
            </div>
            <div class="w-24 h-20 rounded-[6px] overflow-hidden">
              <Photo assetKey="fk_turtle" alt="Sukamade turtles" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="absolute left-1/2 -ml-[6px] w-3 h-3 rounded-full bg-[var(--nt-ink)] ring-4 ring-[#0b0a0a]"></div>
          <div class="pl-6">
            <span class="text-[13px] text-[var(--nt-muted)]">Turtles & off-road</span>
            <h3 class="font-heading text-2xl md:text-3xl font-medium text-white">Sukamade</h3>
          </div>
        </div>
      </div>

      <!-- Mobile Timeline Alternative -->
      <div class="md:hidden space-y-6">
        <div class="glass p-4 rounded-[12px]">
          <span class="text-[12px] text-[var(--nt-muted)] uppercase tracking-wider">Midnight hike</span>
          <h3 class="font-heading text-2xl text-white mb-3">Ijen</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_0683" alt="Ijen" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_3523" alt="Ijen crater" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
        <div class="glass p-4 rounded-[12px]">
          <span class="text-[12px] text-[var(--nt-muted)] uppercase tracking-wider">4WD jeep at 03:30</span>
          <h3 class="font-heading text-2xl text-white mb-3">Bromo</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_3054" alt="Bromo" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2507" alt="Bromo sunrise" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
        <div class="glass p-4 rounded-[12px]">
          <span class="text-[12px] text-[var(--nt-muted)] uppercase tracking-wider">Waterfall trek</span>
          <h3 class="font-heading text-2xl text-white mb-3">Tumpak Sewu</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2414" alt="Tumpak Sewu" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="IMG_2866" alt="Tumpak Sewu stairs" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
        <div class="glass p-4 rounded-[12px]">
          <span class="text-[12px] text-[var(--nt-muted)] uppercase tracking-wider">Turtles & off-road</span>
          <h3 class="font-heading text-2xl text-white mb-3">Sukamade</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="n_sukamade_jeep" alt="Sukamade" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[6px] overflow-hidden">
              <Photo assetKey="fk_turtle" alt="Sukamade turtles" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHERE YOU'LL GO (Schematic Route Diagram) -->
  <section class="container-nt py-16 md:py-24">
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-heading text-3xl md:text-4xl uppercase tracking-[0.04em] text-[var(--nt-body)] whitespace-nowrap">
        Where you'll go
      </h2>
      <div class="flex-1 h-[1px] bg-white/20"></div>
    </div>

    <!-- Route Line Container -->
    <div class="overflow-x-auto pb-6 scrollbar-none">
      <div class="min-w-[800px] relative pt-12 pb-24">
        <!-- Main Line -->
        <div class="absolute left-[10%] right-[10%] top-[96px] h-[1px] bg-white/40"></div>

        <!-- Drive time labels above line -->
        <div class="absolute top-[56px] left-[20%] -translate-x-1/2 text-center text-[13px] leading-tight text-[var(--nt-body)] whitespace-nowrap">
          4–5 h drive<br />+ ~1 h ferry
        </div>
        <div class="absolute top-[56px] left-[40%] -translate-x-1/2 text-center text-[13px] leading-tight text-[var(--nt-body)] whitespace-nowrap">
          6–7 h
        </div>
        <div class="absolute top-[56px] left-[60%] -translate-x-1/2 text-center text-[13px] leading-tight text-[var(--nt-body)] whitespace-nowrap">
          3–4 h
        </div>
        <div class="absolute top-[56px] left-[80%] -translate-x-1/2 text-center text-[13px] leading-tight text-[var(--nt-body)] whitespace-nowrap">
          3–4 h
        </div>

        <!-- 5 Nodes along main track -->
        <!-- Node 1: Bali -->
        <div class="absolute top-[91px] left-[10%] -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--nt-ink)]"></div>
        <div class="absolute top-[116px] left-[10%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-2xl font-medium text-white">Bali</div>
          <div class="text-[13px] text-[var(--nt-muted)]">Pick-up</div>
        </div>

        <!-- Node 2: Ijen -->
        <div class="absolute top-[91px] left-[30%] -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--nt-ink)]"></div>
        <div class="absolute top-[116px] left-[30%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-2xl font-medium text-white">Ijen</div>
          <div class="text-[13px] text-[var(--nt-muted)]">Banyuwangi</div>
        </div>

        <!-- Node 3: Tumpak Sewu -->
        <div class="absolute top-[91px] left-[50%] -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--nt-ink)]"></div>
        <div class="absolute top-[116px] left-[50%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-2xl font-medium text-white">Tumpak Sewu</div>
          <div class="text-[13px] text-[var(--nt-muted)]">Lumajang</div>
        </div>

        <!-- Node 4: Bromo -->
        <div class="absolute top-[91px] left-[70%] -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--nt-ink)]"></div>
        <div class="absolute top-[116px] left-[70%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-2xl font-medium text-white">Bromo</div>
          <div class="text-[13px] text-[var(--nt-muted)]">Probolinggo</div>
        </div>

        <!-- Node 5: Surabaya -->
        <div class="absolute top-[91px] left-[90%] -translate-x-1/2 w-3 h-3 rounded-full bg-[var(--nt-ink)]"></div>
        <div class="absolute top-[116px] left-[90%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-2xl font-medium text-white">Surabaya</div>
          <div class="text-[13px] text-[var(--nt-muted)]">Start or drop-off</div>
        </div>

        <!-- Branch to Sukamade -->
        <div class="absolute left-[30%] top-[176px] h-7 border-l border-dashed border-white/50"></div>
        <div class="absolute top-[204px] left-[30%] -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-[var(--nt-lime)]"></div>
        <div class="absolute top-[220px] left-[30%] -translate-x-1/2 text-center whitespace-nowrap">
          <div class="font-heading text-xl text-white">Sukamade</div>
          <div class="text-[13px] text-[var(--nt-muted)]">from Banyuwangi, jungle off-road</div>
        </div>
      </div>
    </div>

    <!-- Footnote about route times -->
    <p class="mt-4 text-[13px] text-[var(--nt-muted)] leading-relaxed">
      Surabaya ↔ Banyuwangi: 6–7 h. Drive times are estimates and change with traffic. The Yogyakarta tours are full-day trips from Yogyakarta city.
    </p>
  </section>

  <!-- 4. POPULAR TRIPS SECTION -->
  <section class="container-nt py-16 md:py-24" id="trips">
    <div class="flex items-center justify-between gap-6 mb-12">
      <div class="flex items-center gap-6 flex-1">
        <h2 class="font-heading text-3xl md:text-4xl uppercase tracking-[0.04em] text-[var(--nt-body)] whitespace-nowrap">
          Popular trips
        </h2>
        <div class="flex-1 h-[1px] bg-white/20"></div>
      </div>
      <a href="/trips" class="text-sm font-medium text-[var(--nt-lime)] hover:underline whitespace-nowrap">
        All 15 trips →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {popularTrips.map((trip) => (
        <TripCard trip={trip} />
      ))}
    </div>

    <p class="mt-6 text-[13px] text-[var(--nt-muted)] leading-relaxed">
      Rates are per person for a private group of 4, 2026. Peak season (Eid, New Year) +20%.
    </p>
  </section>

  <!-- 5. HOW IT WORKS SECTION -->
  <section class="container-nt py-16 md:py-24">
    <div class="flex items-center gap-6 mb-12">
      <h2 class="font-heading text-3xl md:text-4xl uppercase tracking-[0.04em] text-[var(--nt-body)] whitespace-nowrap">
        How it works
      </h2>
      <div class="flex-1 h-[1px] bg-white/20"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Step 1 -->
      <div class="glass p-6 md:p-8 rounded-[14px]">
        <span class="w-8 h-8 rounded-full bg-[var(--nt-lime)] text-[#14170a] font-semibold text-sm flex items-center justify-center">
          1
        </span>
        <h3 class="font-heading text-2xl text-white mt-4 mb-2">Choose a trip</h3>
        <p class="text-sm md:text-[15px] leading-relaxed text-[var(--nt-body)]">
          Pick a route from the list, or tell us where you want to go and we will plan it with you.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="glass p-6 md:p-8 rounded-[14px]">
        <span class="w-8 h-8 rounded-full bg-[var(--nt-lime)] text-[#14170a] font-semibold text-sm flex items-center justify-center">
          2
        </span>
        <h3 class="font-heading text-2xl text-white mt-4 mb-2">Send a request</h3>
        <p class="text-sm md:text-[15px] leading-relaxed text-[var(--nt-body)]">
          Share your dates, group size, stay type and pick-up area. No payment at this step.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="glass p-6 md:p-8 rounded-[14px]">
        <span class="w-8 h-8 rounded-full bg-[var(--nt-lime)] text-[#14170a] font-semibold text-sm flex items-center justify-center">
          3
        </span>
        <h3 class="font-heading text-2xl text-white mt-4 mb-2">We confirm & meet</h3>
        <p class="text-sm md:text-[15px] leading-relaxed text-[var(--nt-body)]">
          We contact you on WhatsApp with availability and your final quote. Then your driver and guide meet you at your hotel.
        </p>
      </div>
    </div>
  </section>

