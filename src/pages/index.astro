            name="name"
            type="text"
            required
            class="block w-full h-11 my-1 mb-3.5 px-3 rounded-[6px] border border-white/40 bg-white/[0.08] text-white font-inherit focus:border-[var(--color-accent)] focus:outline-none"
          />

