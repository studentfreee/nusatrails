---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import TripCard from '../components/TripCard.astro';
import Footer from '../components/Footer.astro';
import { getTrips } from '../lib/data';

const allTrips = getTrips();

// Popular trips slugs defined in PRD section 6.1
const popularSlugs = [
  'ijen-blue-fire-1-day',
  'ijen-bromo-3d2n-from-surabaya',
  'ijen-tumpak-sewu-bromo-4d3n-bali-to-surabaya',
  'sukamade-wildlife-2d1n-from-banyuwangi',
  'borobudur-prambanan-1-day-from-yogyakarta',
  'jomblang-pindul-cave-1-day-from-yogyakarta',
];

const popularTrips = popularSlugs
  .map((slug) => allTrips.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'NusaTrails',
  url: 'https://nusatrails.id',
  logo: 'https://nusatrails.id/icon-512.png',
  description:
    'Private tours across East Java and Yogyakarta: Ijen blue fire, Mount Bromo, Tumpak Sewu, Sukamade, and Borobudur.',
  areaServed: ['East Java', 'Yogyakarta', 'Bali', 'Indonesia'],
  priceRange: '$$',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Customer Reservations',
    availableLanguage: ['English', 'Indonesian'],
  },
};
---

<Base
  description="Private trips across East Java & Yogyakarta: Ijen blue fire, Mount Bromo, Tumpak Sewu waterfall, Sukamade turtles, Borobudur and Prambanan. Small private groups with driver and guide."
  ogTitle="NusaTrails – Private Trips in East Java & Yogyakarta"
  hideFooter={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <!-- 1. HERO SECTION (Layered title - Key effect) -->
  <section class="relative overflow-hidden min-h-[900px] md:h-[940px] lg:h-[960px] bg-[#0b0a0a]">
    <!-- Layer 1: Background mountain photo -->
    <div class="absolute inset-0 z-0">
      <Photo
        assetKey="home_hero_bg"
        alt="Mount Bromo Caldera"
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
    </div>

    <!-- Layer 2: Big Title centered behind the mountain ridge -->
    <div class="absolute top-[65px] md:top-[75px] inset-x-0 w-full z-10 pointer-events-none select-none text-center px-4">
      <h1 class="font-heading font-semibold text-[clamp(44px,11.5vw,76px)] sm:text-[115px] md:text-[150px] lg:text-[185px] uppercase tracking-[0.03em] leading-none text-white/80 whitespace-nowrap inline-block">
        NusaTrails
      </h1>
    </div>

    <!-- Layer 3: Foreground photo clipped along mountain ridge -->
    <div class="absolute inset-0 z-20 pointer-events-none hero-clipped-ridge">
      <Photo
        assetKey="home_hero_bg"
        alt=""
        class="w-full h-full object-cover object-center"
        loading="eager"
      />
    </div>

    <!-- Layer 4: Dark gradient overlay (top .3 to clear, clear to .6 at 72%, then #0b0a0a at bottom) -->
    <div
      class="absolute inset-0 z-20 pointer-events-none"
      style="background: linear-gradient(180deg, rgba(11,10,10,.3) 0%, rgba(11,10,10,0) 16%, rgba(11,10,10,0) 50%, rgba(11,10,10,.6) 72%, #0b0a0a 100%);"
    ></div>

    <!-- Layer 5: Hero Content (Bottom cards and CTAs) -->
    <div class="absolute bottom-8 sm:bottom-10 lg:bottom-12 inset-x-0 mx-auto max-w-[1520px] px-4 sm:px-6 md:px-8 lg:px-8 xl:px-10 z-30">
      <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 lg:gap-8 xl:gap-10">
        <!-- 6 Rich Photo Cards (Side-by-side single row with unique friendly animations) -->
        <div class="w-full lg:w-auto overflow-x-auto pb-3 scrollbar-none [mask-image:linear-gradient(to_right,black_calc(100%-36px),transparent)] lg:[mask-image:none]">
          <div class="flex gap-3 sm:gap-3.5 min-w-max pr-6 lg:pr-0 pt-2 pb-1">
            <!-- Card 1: 6 destinations across Java -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="tim05" alt="Java destinations" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                6 destinations<br />across Java
              </p>
            </div>

            <!-- Card 2: sunrise at 2,700 m -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="IMG_2509" alt="Bromo sunrise" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                sunrise at<br />2,700 m
              </p>
            </div>

            <!-- Card 3: blue fire at midnight -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="IMG_0683" alt="Ijen blue fire" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                blue fire<br />at midnight
              </p>
            </div>

            <!-- Card 4: thousand waterfalls at Tumpak Sewu -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="IMG_2414" alt="Tumpak Sewu waterfall" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                thousand waterfalls<br />at Tumpak Sewu
              </p>
            </div>

            <!-- Card 5: sea turtles at night -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="fk_turtle" alt="Sukamade sea turtles" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                sea turtles<br />at night
              </p>
            </div>

            <!-- Card 6: from Bali, Surabaya & Yogyakarta -->
            <div class="hero-card-float glass w-[142px] sm:w-[152px] md:w-[162px] lg:w-[168px] p-2.5 rounded-[10px] bg-black/65 border border-white/20 transition-all duration-300 flex flex-col group shrink-0 shadow-2xl cursor-pointer">
              <div class="w-full h-[155px] sm:h-[170px] md:h-[185px] lg:h-[192px] rounded-[6px] overflow-hidden mb-2.5 relative">
                <Photo assetKey="tim10" alt="Pick-up points" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" />
              </div>
              <p class="text-[13px] md:text-[14px] font-medium leading-snug text-white group-hover:text-[var(--color-accent)] transition-colors px-0.5 pb-0.5">
                from Bali, Surabaya<br />& Yogyakarta
              </p>
            </div>
          </div>
        </div>

        <!-- Tag, Description & Action Buttons (Slightly larger to balance bigger cards) -->
        <div class="max-w-[290px] md:max-w-[310px] xl:max-w-[340px] shrink-0 text-left flex flex-col gap-3.5 sm:gap-4">
          <div class="text-[13px] md:text-[14px] tracking-[0.22em] uppercase text-[var(--color-accent)] font-semibold">
            PRIVATE TRIPS · INDONESIA
          </div>
          <p class="text-[15px] sm:text-[16px] md:text-[17px] leading-[1.6] text-white/95 m-0 font-normal">
            Private trips for small groups, picked up from Bali, Surabaya or Yogyakarta. From IDR 606.000 per person.
          </p>
          <div class="flex items-center gap-3.5 pt-1">
            <a
              href="/trips"
              class="inline-flex items-center justify-center h-11 px-6 rounded-full bg-[var(--color-accent,#b9d44a)] text-[#14170a] text-[15px] font-semibold hover:brightness-105 transition shadow-lg"
            >
              See trips
            </a>
            <a
              href="/book"
              class="inline-flex items-center justify-center h-11 px-7 rounded-full bg-black/50 border border-white/60 text-white text-[15px] font-normal hover:bg-white/10 transition shadow-lg"
            >
              Book
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ABOUT THE TOUR SECTION -->
  <section class="container-nt py-20 md:py-28" id="about">
    <div class="flex items-center justify-center gap-4 md:gap-8 mb-12 md:mb-16">
      <div class="flex-1 h-px bg-white/25"></div>
      <h2 class="font-heading text-2xl md:text-4xl lg:text-5xl uppercase tracking-[0.08em] text-white whitespace-nowrap text-center">
        About the tour
      </h2>
      <div class="flex-1 h-px bg-white/25"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-12 lg:gap-16 items-start">
      <!-- Left Column: Intro Description -->
      <div class="text-[16px] leading-[1.7] text-[#d9d3c8] lg:sticky lg:top-24">
        <p class="m-0">
          We've planned simple, convenient itineraries across Java. Choose from six iconic highlights: <span class="text-[var(--color-accent)] font-medium">Ijen, Bromo, Tumpak Sewu and Sukamade</span> in East Java, plus <span class="text-[var(--color-accent)] font-medium">Borobudur & Prambanan</span> and <span class="text-[var(--color-accent)] font-medium">Jomblang & Pindul Cave</span> near Yogyakarta.
        </p>
        <p class="mt-6 md:mt-8">
          No need to worry about routes, schedules or finding places. Everything is organized: private driver, English-speaking guide, tickets and stays. Pick 1 to 4 days and <span class="text-[var(--color-accent)] font-medium">enjoy the journey</span>.
        </p>
        
        <div class="mt-8 pt-6 border-t border-white/15 hidden lg:block">
          <div class="text-xs uppercase tracking-wider text-[var(--nt-muted)] mb-3">Trip Highlights at a Glance</div>
          <ul class="space-y-2 text-sm text-white/90">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
              Private overland transfers across East Java
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
              Sunrise volcano summits & off-road jungle 4WD
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
              UNESCO ancient temples & mystical caving
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Rich Zig-zag Timeline with Overlapping Photo Collages -->
      <div class="relative hidden md:grid grid-cols-[1fr_28px_1fr] row-gap-12 gap-y-12 items-center">
        <div class="absolute left-1/2 top-4 bottom-4 w-px bg-white/35 -translate-x-1/2 pointer-events-none"></div>

        <!-- Stop 1: Ijen (Right side photo collage, Left side label) -->
        <div class="text-right pr-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Midnight hike · 2,799 m</div>
          <div class="font-heading text-[26px] text-white leading-tight">Ijen Crater</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Banyuwangi, East Java</div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="relative w-52 h-32 flex items-center pl-2">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-2 top-0 z-10 transform -rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_0683" alt="Ijen blue fire" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-0 bottom-0 z-20 transform rotate-3 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_3523" alt="Ijen acid lake" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Stop 2: Bromo (Left side photo collage, Right side label) -->
        <div class="relative w-52 h-32 flex items-center justify-end pr-2 justify-self-end">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-0 top-0 z-10 transform -rotate-3 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_3054" alt="Bromo 4WD Jeep" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-2 bottom-0 z-20 transform rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_2507" alt="Bromo sunrise vista" class="w-full h-full object-cover" />
          </div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="text-left pl-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">4WD jeep at 03:30</div>
          <div class="font-heading text-[26px] text-white leading-tight">Mount Bromo</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Probolinggo, East Java</div>
        </div>

        <!-- Stop 3: Tumpak Sewu (Right side photo collage, Left side label) -->
        <div class="text-right pr-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Canyon waterfall trek</div>
          <div class="font-heading text-[26px] text-white leading-tight">Tumpak Sewu</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Lumajang, East Java</div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="relative w-52 h-32 flex items-center pl-2">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-2 top-0 z-10 transform rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_2414" alt="Tumpak Sewu panoramic" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-0 bottom-0 z-20 transform -rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="IMG_2866" alt="Tumpak Sewu canyon floor" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Stop 4: Sukamade (Left side photo collage, Right side label) -->
        <div class="relative w-52 h-32 flex items-center justify-end pr-2 justify-self-end">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-0 top-0 z-10 transform -rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="n_sukamade_jeep" alt="Sukamade jungle 4WD" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-2 bottom-0 z-20 transform rotate-3 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="fk_turtle" alt="Sukamade sea turtles" class="w-full h-full object-cover" />
          </div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="text-left pl-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Jungle off-road & turtles</div>
          <div class="font-heading text-[26px] text-white leading-tight">Sukamade</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Meru Betiri National Park</div>
        </div>

        <!-- Stop 5: Borobudur & Prambanan (Right side photo collage, Left side label) -->
        <div class="text-right pr-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Ancient temple sunrise</div>
          <div class="font-heading text-[26px] text-white leading-tight">Borobudur & Prambanan</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Central Java & Yogyakarta</div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="relative w-52 h-32 flex items-center pl-2">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-2 top-0 z-10 transform -rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="n_borobudur_aerial" alt="Borobudur sunrise aerial" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-0 bottom-0 z-20 transform rotate-3 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="n_borobudur_stupa" alt="Borobudur stupas" class="w-full h-full object-cover" />
          </div>
        </div>

        <!-- Stop 6: Jomblang & Pindul (Left side photo collage, Right side label) -->
        <div class="relative w-52 h-32 flex items-center justify-end pr-2 justify-self-end">
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-lg border border-white/20 absolute left-0 top-0 z-10 transform -rotate-3 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="fk_rope" alt="Jomblang vertical rappel" class="w-full h-full object-cover" />
          </div>
          <div class="w-32 h-24 rounded-[8px] overflow-hidden shadow-2xl border border-white/35 absolute right-2 bottom-0 z-20 transform rotate-2 hover:rotate-0 hover:scale-105 transition duration-300">
            <Photo assetKey="fk_light" alt="Jomblang light of heaven" class="w-full h-full object-cover" />
          </div>
        </div>
        <div class="flex justify-center">
          <span class="w-3.5 h-3.5 rounded-full bg-[var(--color-accent)] border-2 border-black/80 shadow-md"></span>
        </div>
        <div class="text-left pl-2">
          <div class="text-[12px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Light of heaven & river tubing</div>
          <div class="font-heading text-[26px] text-white leading-tight">Jomblang & Pindul</div>
          <div class="text-[13px] text-[var(--nt-muted)] mt-1">Gunungkidul, Yogyakarta</div>
        </div>
      </div>

      <!-- Mobile Timeline Alternative: 6 Clean Photo Cards -->
      <div class="md:hidden space-y-6">
        <!-- Stop 1: Ijen -->
        <div class="glass p-4 rounded-[14px] border border-white/15">
          <div class="flex justify-between items-start mb-2">
            <div>
              <span class="text-[11px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Midnight hike · 2,799 m</span>
              <h3 class="font-heading text-2xl text-white">Ijen Crater</h3>
            </div>
            <span class="text-xs text-[var(--nt-muted)]">Banyuwangi</span>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div class="aspect-[4/3] w-full rounded-[8px] overflow-hidden border border-white/15">
              <Photo assetKey="IMG_0683" alt="Ijen blue fire" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[8px] overflow-hidden border border-white/15">
              <Photo assetKey="IMG_3523" alt="Ijen crater" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <!-- Stop 2: Bromo -->
        <div class="glass p-4 rounded-[14px] border border-white/15">
          <div class="flex justify-between items-start mb-2">
            <div>
              <span class="text-[11px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">4WD jeep at 03:30</span>
              <h3 class="font-heading text-2xl text-white">Mount Bromo</h3>
            </div>
            <span class="text-xs text-[var(--nt-muted)]">Probolinggo</span>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div class="aspect-[4/3] w-full rounded-[8px] overflow-hidden border border-white/15">
              <Photo assetKey="IMG_3054" alt="Bromo 4WD Jeep" class="w-full h-full object-cover" />
            </div>
            <div class="aspect-[4/3] w-full rounded-[8px] overflow-hidden border border-white/15">
              <Photo assetKey="IMG_2507" alt="Bromo sunrise" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>

        <!-- Stop 3: Tumpak Sewu -->
        <div class="glass p-4 rounded-[14px] border border-white/15">
          <div class="flex justify-between items-start mb-2">
            <div>
              <span class="text-[11px] uppercase tracking-wider text-[var(--color-accent)] font-semibold">Canyon waterfall trek</span>
              <h3 class="font-heading text-2xl text-white">Tumpak Sewu</h3>
            </div>
            <span class="text-xs text-[var(--nt-muted)]">Lumajang</span>
