<style>
  /* Mountain ridge clipping path as specified in PRD section 5 */
  .hero-clipped-ridge {
    clip-path: polygon(
      0% 22.5%,
      8% 23.2%,
      15% 22.4%,
      20% 22%,
      24% 22.8%,
      30% 25%,
      36% 26%,
      50% 26%,
      55% 25.7%,
      59% 25.5%,
      62% 24%,
      65% 22.6%,
      70% 22%,
      75% 21.2%,
      78% 20.6%,
      80% 20.2%,
      82% 21.5%,
      84% 22.3%,
      86% 21.7%,
      88% 23%,
      92% 26%,
      96% 28%,
      100% 30%,
      100% 100%,
      0% 100%
    );
  }

  /* 1. Hero floating photo cards animations */
  @keyframes heroCardFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(0.4deg);
    }
  }

  .hero-card-float {
    animation: heroCardFloat 5s ease-in-out infinite;
    position: relative;
    overflow: hidden;
    will-change: transform;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.4s ease;
  }
  .hero-card-float:nth-child(1) { animation-delay: 0s; --tilt: -1.5deg; }
  .hero-card-float:nth-child(2) { animation-delay: 0.7s; --tilt: 1.2deg; }
  .hero-card-float:nth-child(3) { animation-delay: 1.4s; --tilt: -1deg; }
  .hero-card-float:nth-child(4) { animation-delay: 2.1s; --tilt: 1.5deg; }
  .hero-card-float:nth-child(5) { animation-delay: 2.8s; --tilt: -1.2deg; }
  .hero-card-float:nth-child(6) { animation-delay: 3.5s; --tilt: 1deg; }

  .hero-card-float:hover {
    animation-play-state: paused;
    transform: translateY(-12px) scale(1.05) rotate(var(--tilt, 1.5deg));
    border-color: rgba(185, 212, 74, 0.65) !important;
    box-shadow: 0 22px 40px -10px rgba(185, 212, 74, 0.35), 0 0 20px rgba(255, 255, 255, 0.15) !important;
  }

  /* Shimmer sweep effect on hero card hover */
  .hero-card-float::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -70%;
    width: 50%;
    height: 200%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    transform: rotate(25deg);
    pointer-events: none;
    opacity: 0;
  }
  .hero-card-float:hover::after {
    opacity: 1;
    left: 140%;
    transition: left 0.75s ease-in-out;
  }

  /* 2. What's Included bento cards animations */
  .included-bento-card {
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.35s ease;
  }
  .included-bento-card:hover {
    transform: translateY(-8px) scale(1.015);
    border-color: rgba(185, 212, 74, 0.5) !important;
    box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.6), 0 0 25px rgba(185, 212, 74, 0.18) !important;
  }

  /* 3. How It Works step cards animations */
  .how-step-card {
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.35s ease;
  }
  .how-step-card:hover {
    transform: translateY(-8px);
    border-color: rgba(185, 212, 74, 0.5) !important;
    box-shadow: 0 22px 35px -10px rgba(0, 0, 0, 0.6), 0 0 25px rgba(185, 212, 74, 0.18) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-card-float {
      animation: none !important;
    }
  }
</style>

<script>
  function setupHomeForm() {
    const form = document.getElementById('home-lead-form') as HTMLFormElement | null;
    const btn = document.getElementById('home-form-btn') as HTMLButtonElement | null;
    const statusEl = document.getElementById('home-form-status');

    if (!form || !btn || !statusEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const phone = formData.get('whatsapp') as string;
      const comment = formData.get('comment') as string;
      const honeypot = formData.get('website') as string;

      if (honeypot) return; // bot

      btn.disabled = true;
      btn.textContent = 'Sending...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'question',
            full_name: name,
            whatsapp: phone,
            notes: comment,
            consent: true,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          statusEl.textContent = `Thank you! Your request ${data.reference ? `(${data.reference})` : ''} has been received. Our team will contact you on WhatsApp shortly.`;
          statusEl.className = 'text-sm text-[var(--nt-lime)] pt-1';
          statusEl.classList.remove('hidden');
          form.reset();
        } else {
          const err = data.error || 'Failed to submit request. Please try contacting us on WhatsApp directly.';
          statusEl.textContent = err;
          statusEl.className = 'text-sm text-red-400 pt-1';
          statusEl.classList.remove('hidden');
        }
      } catch (e) {
        statusEl.textContent = 'Network error. Please chat with us directly via WhatsApp.';
        statusEl.className = 'text-sm text-red-400 pt-1';
        statusEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send';
      }
    });
  }

  setupHomeForm();
  document.addEventListener('astro:page-load', setupHomeForm);
</script>
