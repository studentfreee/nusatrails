<script>
  function setupHomeForm() {
    const form = document.getElementById('home-lead-form') as HTMLFormElement | null;
    const btn = document.getElementById('home-form-btn') as HTMLButtonElement | null;
    const statusEl = document.getElementById('home-form-status');

    if (!form || !btn || !statusEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const phone = formData.get('whatsapp') as string;
      const comment = formData.get('comment') as string;
      const honeypot = formData.get('website') as string;

      if (honeypot) return; // bot

      btn.disabled = true;
      btn.textContent = 'Sending...';
      statusEl.classList.add('hidden');

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'question',
            full_name: name,
            whatsapp: phone,
            notes: comment,
            consent: true,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          statusEl.textContent = `Thank you! Your request ${data.reference ? `(${data.reference})` : ''} has been received. Our team will contact you on WhatsApp shortly.`;
          statusEl.className = 'text-sm text-[var(--nt-lime)] pt-1';
          statusEl.classList.remove('hidden');
          form.reset();
        } else {
          const err = data.error || 'Failed to submit request. Please try contacting us on WhatsApp directly.';
          statusEl.textContent = err;
          statusEl.className = 'text-sm text-red-400 pt-1';
          statusEl.classList.remove('hidden');
        }
      } catch (e) {
        statusEl.textContent = 'Network error. Please chat with us directly via WhatsApp.';
        statusEl.className = 'text-sm text-red-400 pt-1';
        statusEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send';
      }
    });
  }

  setupHomeForm();
  document.addEventListener('astro:page-load', setupHomeForm);
</script>
