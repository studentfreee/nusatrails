---
interface Props {
  /** Size for the SVG icon */
  iconSize?: number;
  /** Show the live text wordmark next to the emblem. */
  wordmark?: boolean;
}
const { iconSize = 20, wordmark = true } = Astro.props;
---
<a href="/" class="logo" aria-label="NusaTrails, home">
  <svg class="logo-icon" width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>
  </svg>
  {wordmark && (
    <span class="word">NUSA<span>TRAILS</span></span>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    transition: opacity .2s;
  }
  .logo:hover {
    opacity: 0.88;
  }
  .logo-icon {
    flex: none;
    color: #fff;
  }
  .word {
    font-family: var(--font-display, Oswald, sans-serif);
    font-weight: 500;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
  }
  .word span {
    color: var(--color-accent, #b9d44a);
  }
</style>
