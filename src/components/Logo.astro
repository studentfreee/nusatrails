---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';

interface Props {
  /** Size for the logo icon in px */
  iconSize?: number;
  size?: number;
  /** Show the live text wordmark next to the emblem. */
  wordmark?: boolean;
}
const { iconSize, size, wordmark = true } = Astro.props;
const finalSize = iconSize ?? size ?? 26;
---
<a href="/" class="logo" aria-label="NusaTrails, home">
  <Image
    src={logoMark}
    alt="NusaTrails logo"
    width={finalSize * 2}
    height={finalSize * 2}
    class="logo-img"
    style={`width: ${finalSize}px; height: ${finalSize}px;`}
    loading="eager"
  />
  {wordmark && (
    <span class="word">NUSA<span>TRAILS</span></span>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    transition: opacity .2s;
  }
  .logo:hover {
    opacity: 0.88;
  }
  .logo-img {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .word {
    font-family: var(--font-display, Oswald, sans-serif);
    font-weight: 500;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
  }
  .word span {
    color: var(--color-accent, #b9d44a);
  }
</style>
