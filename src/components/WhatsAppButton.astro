---
import { HAS_WHATSAPP, whatsappLink } from '../lib/site';
---
<a
  id="whatsapp-button"
  class="wa"
  href={whatsappLink()}
  target={HAS_WHATSAPP ? '_blank' : undefined}
  rel={HAS_WHATSAPP ? 'noopener' : undefined}
  aria-label="Chat with NusaTrails on WhatsApp"
  title={HAS_WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number not set yet [CONFIRM]'}
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2a9.9 9.9 0 0 0-8.43 15.12L2 22l5-1.58A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.2 15.03l-.3-.18-2.97.94.97-2.89-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.2 4.1c-.17 0-.45.06-.69.32-.24.26-.9.88-.9 2.15s.92 2.5 1.05 2.67c.13.17 1.8 2.88 4.45 3.92 2.2.87 2.65.7 3.13.65.48-.04 1.54-.63 1.76-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.59.13-.17.26-.67.85-.82 1.02-.15.17-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.29-.77-.69-1.3-1.54-1.45-1.8-.15-.26-.02-.4.11-.53.12-.12.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.33-.02-.46-.07-.13-.58-1.4-.8-1.92-.2-.5-.42-.43-.58-.44h-.5Z"/>
  </svg>
</a>

<style>
  .wa {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    width: 60px; height: 60px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--color-accent); color: var(--color-on-accent);
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .wa:hover { transform: scale(1.06); box-shadow: 0 12px 30px rgba(185,212,74,.35); }
</style>
