---
import Logo from './Logo.astro';
import { NAV_LINKS } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav-wrap">
  <div class="container-nt">
    <nav class="nav-pill nav" aria-label="Main">
      <Logo iconSize={20} />
      <ul class="links">
        {NAV_LINKS.map((l) => (
          <li>
            <a href={l.href} class:list={['link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <button class="burger" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <ul class="menu" id="nav-menu" hidden>
      {NAV_LINKS.map((l) => (
        <li><a href={l.href} class:list={['mlink', { active: isActive(l.href) }]}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<!-- App-Style Bottom Navigation for Mobile (Native App Experience) -->
<nav class="mobile-app-nav" aria-label="Mobile Navigation">
  <a href="/" class:list={['app-tab', { active: path === '/' }]}>
    <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span class="tab-label">Home</span>
  </a>

  <a href="/trips" class:list={['app-tab', { active: path.startsWith('/trips') }]}>
    <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="3 11 22 2 13 21 11 13 3 11"/>
    </svg>
    <span class="tab-label">Trips</span>
  </a>

  <a href="/about" class:list={['app-tab', { active: path.startsWith('/about') }]}>
    <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="16" x2="12" y2="12"/>
      <line x1="12" y1="8" x2="12.01" y2="8"/>
    </svg>
    <span class="tab-label">About</span>
  </a>

  <a href="/faq" class:list={['app-tab', { active: path.startsWith('/faq') }]}>
    <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <span class="tab-label">FAQ</span>
  </a>

  <a href="/book" class:list={['app-tab app-tab-book', { active: path.startsWith('/book') }]}>
    <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="tab-label">Book</span>
  </a>
</nav>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>

<style>
  /* Desktop Top Navigation (100% UNCHANGED) */
  .nav-wrap { position: absolute; top: 28px; left: 0; right: 0; z-index: 50; }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px 0 20px;
    height: 60px;
    background: rgba(11,10,10,.5);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 999px;
  }
  @media (min-width: 768px) {
    .nav { padding: 0 28px; }
  }
  .links { display: none; list-style: none; margin: 0; padding: 0; gap: 36px; }
  .link { font-size: 14px; font-weight: 500; text-decoration: none; color: #fff; transition: color .2s; }
  .link:hover, .link.active { color: var(--color-accent, #b9d44a); }
  .burger { display: grid; gap: 5px; padding: 12px 14px; background: none; border: 0; cursor: pointer; }
  .burger span { display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px; }
  .menu {
    list-style: none; margin: 10px 0 0; padding: 12px; display: grid; gap: 4px;
    background: rgba(11,10,10,.97); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,.25); border-radius: 20px;
  }
  .menu[hidden] { display: none; }
  .mlink { display: block; padding: 12px 16px; border-radius: 12px; text-decoration: none; color: #fff; font-weight: 500; }
  .mlink.active { color: var(--color-accent, #b9d44a); }
  .mlink:hover { background: rgba(255,255,255,.06); }
  @media (min-width: 768px) {
    .links { display: flex; }
    .burger, .menu { display: none !important; }
  }

  /* Mobile App-Style Bottom Navigation */
  @media (max-width: 767px) {
    .nav-wrap { display: none !important; }
  }
  @media (min-width: 768px) {
    .mobile-app-nav { display: none !important; }
  }

  .mobile-app-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background: rgba(13, 12, 12, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 8px calc(env(safe-area-inset-bottom, 0px) + 2px);
  }
  .app-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    flex: 1;
    height: 100%;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .app-tab:hover {
    color: #ffffff;
  }
  .app-tab.active {
    color: var(--color-accent, #b9d44a);
  }
  .tab-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
  }
  .app-tab.active .tab-icon {
    transform: translateY(-1px);
  }
  .tab-label {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .app-tab-book {
    color: var(--color-accent, #b9d44a);
  }
  .app-tab-book .tab-label {
    font-weight: 600;
  }
</style>
