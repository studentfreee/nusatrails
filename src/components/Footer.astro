---
import Logo from './Logo.astro';
import { NAV_LINKS, HAS_WHATSAPP, whatsappLink, INSTAGRAM_URL } from '../lib/site';

interface Props {
  /** If embedded inside a page's existing contact section (like Home) */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');

const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL || INSTAGRAM_URL;
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || '';
const waHref = whatsappLink();
---

{embedded ? (
  <footer class="footer-wrap">
    <div class="footer-icons">
      <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="f-icon">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
      </a>
      <a href={waHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="f-icon">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.5-4.5A8 8 0 1 1 8.5 18.5z"/></svg>
      </a>
      <a href={email ? `mailto:${email}` : '#contact'} aria-label="Email" class="f-icon">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </a>
    </div>
    <div class="footer-row">
      <Logo iconSize={20} />
      <nav aria-label="Footer" class="footer-nav">
        {NAV_LINKS.map((l) => (
          <a href={l.href} class:list={['fl-link', { active: isActive(l.href) }]}>{l.label}</a>
        ))}
      </nav>
    </div>
  </footer>
) : (
  <section id="contact" class="subpage-contact-footer">
    <div class="container-nt h-full relative">
      <footer class="footer-wrap">
        <div class="footer-icons">
          <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="f-icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
          </a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="f-icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.5-4.5A8 8 0 1 1 8.5 18.5z"/></svg>
          </a>
          <a href={email ? `mailto:${email}` : '#contact'} aria-label="Email" class="f-icon">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          </a>
        </div>
        <div class="footer-row">
          <Logo iconSize={20} />
          <nav aria-label="Footer" class="footer-nav">
            {NAV_LINKS.map((l) => (
              <a href={l.href} class:list={['fl-link', { active: isActive(l.href) }]}>{l.label}</a>
            ))}
          </nav>
        </div>
      </footer>
    </div>
  </section>
)}

<style>
  /* Reference subpage footer section: 210px height with dark reddish gradient */
  .subpage-contact-footer {
    position: relative;
    height: 210px;
    background: linear-gradient(180deg, #0b0a0a 0%, #2a1d2a 100%);
    overflow: hidden;
  }
  .footer-wrap {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
  }
  @media (min-width: 1024px) {
    .footer-wrap {
      left: 48px;
      right: 48px;
    }
  }
  .footer-icons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 8px;
  }
  .f-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: all 0.2s ease;
  }
  .f-icon:hover {
    color: var(--color-accent, #b9d44a);
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--color-accent, #b9d44a);
    transform: translateY(-2px);
  }
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
    color: #fff;
  }
  @media (min-width: 768px) {
    .footer-nav {
      gap: 36px;
    }
  }
  .fl-link {
    text-decoration: none;
    color: #fff;
    transition: color 0.2s;
  }
  .fl-link:hover, .fl-link.active {
    color: var(--color-accent, #b9d44a);
  }
</style>
