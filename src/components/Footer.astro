---
import Logo from './Logo.astro';
import { NAV_LINKS, HAS_WHATSAPP, whatsappLink } from '../lib/site';

// Owner contact data is still a placeholder [CONFIRM]; icons render without a dead link.
const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL || '';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || '';
const icons = [
  { id: 'footer-instagram', label: 'Instagram', href: instagram,
    d: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm0 1.8A2.2 2.2 0 0 0 4.8 7v10A2.2 2.2 0 0 0 7 19.2h10a2.2 2.2 0 0 0 2.2-2.2V7A2.2 2.2 0 0 0 17 4.8H7Zm5 2.7a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 1.8a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm4.9-2.4a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z' },
  { id: 'footer-whatsapp', label: 'WhatsApp', href: HAS_WHATSAPP ? whatsappLink() : '',
    d: 'M12.04 2a9.9 9.9 0 0 0-8.43 15.12L2 22l5-1.58A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.2 15.03l-.3-.18-2.97.94.97-2.89-.2-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.2 4.1c-.17 0-.45.06-.69.32-.24.26-.9.88-.9 2.15s.92 2.5 1.05 2.67c.13.17 1.8 2.88 4.45 3.92 2.2.87 2.65.7 3.13.65.48-.04 1.54-.63 1.76-1.24.22-.61.22-1.13.15-1.24-.07-.11-.24-.17-.5-.3-.26-.13-1.54-.76-1.78-.85-.24-.09-.41-.13-.59.13-.17.26-.67.85-.82 1.02-.15.17-.3.2-.57.07-.26-.13-1.1-.4-2.1-1.29-.77-.69-1.3-1.54-1.45-1.8-.15-.26-.02-.4.11-.53.12-.12.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.33-.02-.46-.07-.13-.58-1.4-.8-1.92-.2-.5-.42-.43-.58-.44h-.5Z' },
  { id: 'footer-email', label: 'Email', href: email ? `mailto:${email}` : '',
    d: 'M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 1.8v.3l8 5.1 8-5.1v-.3H4Zm16 2.4-8 5.1-8-5.1V17h16V9.2Z' },
];
---
<footer class="foot">
  <div class="container-nt">
    <ul class="icons" aria-label="Contact">
      {icons.map((i) => (
        <li>
          <a id={i.id} href={i.href || undefined} aria-label={i.label} aria-disabled={i.href ? undefined : 'true'}
             target={i.href.startsWith('http') ? '_blank' : undefined} rel={i.href.startsWith('http') ? 'noopener' : undefined}
             class:list={['icon', { off: !i.href }]}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={i.d} /></svg>
          </a>
        </li>
      ))}
    </ul>
    <div class="row">
      <Logo size={40} />
      <nav aria-label="Footer">
        <ul class="flinks">
          {NAV_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .foot { padding: 56px 0 28px; background: linear-gradient(to bottom, transparent, rgba(11,10,10,.9)); }
  .icons { list-style: none; margin: 0 0 18px; padding: 0; display: flex; justify-content: flex-end; gap: 18px; }
  .icon { color: var(--color-ink); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; transition: color .2s, background .2s; }
  .icon:hover { color: var(--color-accent); background: rgba(255,255,255,.06); }
  .icon.off { opacity: .4; cursor: default; pointer-events: none; }
  .row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .flinks { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; font-size: 13px; font-weight: 500; }
  .flinks a { text-decoration: none; color: var(--color-ink); transition: color .2s; }
  .flinks a:hover { color: var(--color-accent); }
</style>
